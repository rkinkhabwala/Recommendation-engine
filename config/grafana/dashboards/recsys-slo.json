    {
      "type": "timeseries",
      "title": "Error budget burn rate (99.9% SLO, 1h)",
      "description": "1 = consuming budget exactly at the SLO rate; 14.4 pages (2% of a 30-day budget in 1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 - (sum(rate(http_server_requests_seconds_count{uri=\"/v1/recommendations\",status!~\"5..\"}[1h])) / sum(rate(http_server_requests_seconds_count{uri=\"/v1/recommendations\"}[1h])))) / 0.001",
          "legendFormat": "burn 1h",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 20
