{
  "uid": "recsys-serving",
  "title": "Recsys / Serving internals",
  "description": "Per-stage latency, candidate generator health, breakers, caches and JVM.",
  "tags": [
    "recsys"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Stage latency (max over 1m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (stage) (max_over_time(recs_api_stage_seconds_max[1m]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Stage latency (mean)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stage) (rate(recs_api_stage_seconds_sum[5m])) / sum by (stage) (rate(recs_api_stage_seconds_count[5m]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Candidate generators: timeouts and errors",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source, result) (rate(recs_api_generator_total{result!=\"ok\"}[5m]))",
          "legendFormat": "{{source}} {{result}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Circuit breakers (1 = state active)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "resilience4j_circuitbreaker_state{state!=\"closed\"}",
          "legendFormat": "{{name}} {{state}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "L1 cache hit ratio",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (cache) (rate(cache_gets_total{result=\"hit\"}[5m])) / sum by (cache) (rate(cache_gets_total[5m]))",
          "legendFormat": "{{cache}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Served-log queue and drops",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "recs_api_served_log_queue",
          "legendFormat": "queue",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(recs_api_served_log_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "GC pause (max)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance, action) (jvm_gc_pause_seconds_max)",
          "legendFormat": "{{instance}} {{action}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Heap used",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Admission: in-flight vs limit",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (application, instance) (recs_http_in_flight)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (application) (recs_http_max_in_flight)",
          "legendFormat": "limit {{application}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Load shed (503) rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application) (rate(recs_http_admission_rejected_total[5m]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 10
    }
  ]
}
