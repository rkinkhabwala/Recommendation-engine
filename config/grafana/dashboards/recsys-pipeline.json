      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(recs_ingest_events_total{result=\"rejected\"}[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
